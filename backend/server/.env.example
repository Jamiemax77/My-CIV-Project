# Copy to .env and fill in. CloudPanel creates the DB user/name/password for
# you when you add a database in its UI — use those values here.
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=civ_project
DB_USER=civ_user
DB_PASSWORD=change-me

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me

# Where uploaded files are stored on disk (outside any public webroot).
STORAGE_DIR=/home/civ-project/storage
